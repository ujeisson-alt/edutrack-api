{
  "name": "edutrack-api",
  "version": "1.0.0",
  "description": "REST API for an online learning platform: courses, enrollments, student progress, reviews and reports.",
  "main": "dist/server.js",
  "directories": {
    "doc": "docs",
    "test": "tests"
  },
  "scripts": {
    "dev": "nodemon --watch src --ext ts --exec ts-node src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "db:reset": "ts-node src/scripts/resetDb.ts",
    "db:seed": "ts-node src/scripts/seed.ts",
    "db:reset:prod": "node dist/scripts/resetDb.js",
    "db:seed:prod": "node dist/scripts/seed.js",
    "test": "jest --runInBand",
    "test:postman": "newman run docs/postman/EduTrack.postman_collection.json -e docs/postman/EduTrack.local.postman_environment.json"
  },
  "keywords": [
    "express",
    "typescript",
    "postgresql",
    "sequelize",
    "mongodb",
    "jwt",
    "rest-api"
  ],
  "author": "Jeisson Uribe",
  "license": "MIT",
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cors": "^2.8.6",
    "dotenv": "^18.0.4",
    "express": "^4.22.3",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.10.3",
    "morgan": "^1.12.1",
    "pg": "^8.23.0",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.37.8",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/node": "^26.6.3",
    "@types/supertest": "^7.2.1",
    "jest": "^30.5.2",
    "mongodb-memory-server": "^11.3.0",
    "newman": "^6.2.2",
    "nodemon": "^3.1.14",
    "supertest": "^7.3.0",
    "ts-jest": "^29.4.14",
    "ts-node": "^10.9.2",
    "typescript": "5.9"
  },
  "engines": {
    "node": ">=20"
  }
}
