# ─── Server ──────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ─── PostgreSQL (local) ──────────────────────────────────
# En Railway/Render basta con DATABASE_URL (tiene prioridad sobre PG_*)
# DATABASE_URL=
PG_HOST=localhost
PG_PORT=5432
PG_USER=postgres
PG_PASSWORD=your_postgres_password
PG_DATABASE=edutrack_db

# ─── MongoDB ─────────────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017/edutrack_logs

# ─── JWT ─────────────────────────────────────────────────
# Mínimo 32 caracteres. Generar con:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_me_with_a_long_random_string_of_at_least_32_chars
JWT_EXPIRES_IN=24h

# ─── Frontend (CORS) ─────────────────────────────────────
FRONTEND_URL=http://localhost:5173

# ─── Seed (solo desarrollo) ──────────────────────────────
# Contraseña que usan los usuarios demo creados por `npm run db:seed`
SEED_PASSWORD=EduTrack123!
